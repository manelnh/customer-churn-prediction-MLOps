# Optional: required only to dispatch GitHub Actions from the app.
GITHUB_ACTIONS_TOKEN = "github_pat_your_token_here"
GITHUB_REPOSITORY = "your-user-or-org/your-repo"
GITHUB_WORKFLOW_REF = "main"
GITHUB_TRAINING_WORKFLOW = "training.yml"
GITHUB_MONITORING_WORKFLOW = "monitoring.yml"

# Optional: enables persistent prediction, monitoring, and governance history.
DATABASE_URL = "postgresql://user:password@host:5432/database"
